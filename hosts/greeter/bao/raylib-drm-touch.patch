+// Drop a stuck finger and forget the dead fd.
+static void dsl_clear_touch(void)
+{
+    int i = 0;
+
+    for (i = 0; i < MAX_TOUCH_POINTS; i++)
+    {
+        platform.touchActive[i] = false;
+        platform.touchPosition[i].x = -1;
+        platform.touchPosition[i].y = -1;
+        platform.touchId[i] = -1;
+        CORE.Input.Touch.position[i].x = -1;
+        CORE.Input.Touch.position[i].y = -1;
+        CORE.Input.Touch.pointId[i] = -1;
+    }
+
+    CORE.Input.Touch.pointCount = 0;
+    platform.currentButtonStateEvdev[MOUSE_BUTTON_LEFT] = 0;
+}
+
+// The panel hub takes the touchscreen with it. Open the
+// event node that came back. First look is immediate, then
+// about once a second while it is still gone.
+static void dsl_reopen_pointer(void)
+{
+    char path[MAX_FILEPATH_LENGTH] = { 0 };
+    DIR *directory = NULL;
+    struct dirent *entity = NULL;
+
+    if (platform.mouseFd != -1)
+    {
+        close(platform.mouseFd);
+        platform.mouseFd = -1;
+    }
+
+    platform.mouseIsTouch = false;
+    dsl_clear_touch();
+    directory = opendir(DEFAULT_EVDEV_PATH);
+
+    if (directory == NULL) return;
+
+    dsl_pointer_only = 1;
+
+    while ((entity = readdir(directory)) != NULL)
+    {
+        if ((strncmp(entity->d_name, "event", 5) != 0) &&
+            (strncmp(entity->d_name, "mouse", 5) != 0)) continue;
+
+        snprintf(path, MAX_FILEPATH_LENGTH, "%s%s",
+            DEFAULT_EVDEV_PATH, entity->d_name);
+        ConfigureEvdevDevice(path);
+    }
+
+    dsl_pointer_only = 0;
+    closedir(directory);
+}
